[Unit]
Description=PiKVM Serial Terminal Daemon
After=network.target kvmd.service

[Service]
Type=simple
User=kvmd
Group=kvmd
ExecStart=/usr/bin/python -m kvmd_serial_term --config /etc/kvmd/serial-term.yaml
ExecStartPost=/bin/sh -c "sleep 3 && test -S /run/kvmd/serial-term.sock && chmod 660 /run/kvmd/serial-term.sock"
Restart=on-failure
RestartSec=5s

# Allow access to the serial device (Arch Linux uses uucp group)
SupplementaryGroups=uucp

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/run/kvmd /dev
ReadOnlyPaths=/etc/kvmd /usr/share/kvmd
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
