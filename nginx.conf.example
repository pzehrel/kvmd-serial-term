# PiKVM Nginx integration for kvmd-serial-term
#
# This file should be placed at:
#   /usr/share/kvmd/extras/serial-term/nginx.ctx-server.conf
#
# PiKVM automatically includes /usr/share/kvmd/extras/*/nginx.ctx-server.conf
# into the server block — no manual nginx.conf.mako editing needed.

# Serial Terminal
location /serial/ {
    proxy_pass http://unix:/run/kvmd/serial-term.sock:/;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    include /etc/kvmd/nginx/loc-proxy.conf;
    include /etc/kvmd/nginx/loc-websocket.conf;
    include /etc/kvmd/nginx/loc-login.conf;
    include /etc/kvmd/nginx/loc-nocache.conf;
}
